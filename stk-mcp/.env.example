# ── STK connection ────────────────────────────────────────────────────────
# auto = try STK 11 first, then STK 12. Set to STK11.Application or
# STK12.Application to force one installation.
STK_MCP_PROG_ID=auto
STK_MCP_PREFERRED_VERSION=11
STK_MCP_VISIBLE=true
STK_MCP_USER_CONTROL=true
STK_MCP_ATTACH_EXISTING=true
STK_MCP_QUIT_ON_DISCONNECT=false
STK_MCP_CLOSE_SCENARIO_ON_DISCONNECT=false

# ── Scenario defaults ─────────────────────────────────────────────────────
STK_MCP_DEFAULT_SCENARIO=STK_MCP_Scenario
STK_MCP_DEFAULT_DURATION_HOURS=24
STK_MCP_DEFAULT_STEP=60
# Defaults to %USERPROFILE%\.spaceone-stk-mcp. Set an absolute path to override.
# STK_MCP_DATA_DIR=C:\Users\you\.spaceone-stk-mcp

# ── REST server ───────────────────────────────────────────────────────────
STK_MCP_HOST=127.0.0.1
STK_MCP_PORT=8080
# Optional shared secret; when set, clients must send X-API-Key.
STK_MCP_API_KEY=
STK_MCP_REQUEST_TIMEOUT=180
STK_MCP_MAX_ROWS=20000
# Refuse to save if the scenario folder exceeds this size (bytes).
STK_MCP_MAX_SAVE_BYTES=2000000000

# ── STK Connect (TCP fallback, optional) ─────────────────────────────────
STK_MCP_CONNECT_HOST=127.0.0.1
STK_MCP_CONNECT_PORT=5001

# ── Logging ───────────────────────────────────────────────────────────────
STK_MCP_LOG_LEVEL=INFO
